# 기린 사진 특징값을 XOR처럼 "범위 안에 있는가"로 판단하는 실습
# (하한, 상한 두 기준선을 동시에 만족해야 통과 - XOR와 같은 구조)

def predict_giraffe(x1, x2, x3, x4):
    a1, a2, a3, a4 = 0.1, 0.4, 0.3, 0.2
    b = 0.0
    total = a1*x1 + a2*x2 + a3*x3 + a4*x4 + b
    lower, upper = 0.4, 0.8   # XOR의 (0.5, 1.5)와 같은 역할의 기준선 두 개
    if total > upper:
        state = "범위 초과"
        result = "기린 아님"
    elif total < lower:
        state = "범위 부족"
        result = "기린 아님"
    else:
        state = "범위 안"
        result = "기린"
    return result, state, round(total, 3)

photos = {
    "특징이 과하게 강한 사진": (0.9, 1.0, 1.0, 0.9),
    "전형적인 기린 사진":     (0.2, 0.9, 0.8, 0.7),
    "특징이 약한 사진(고양이)": (0.6, 0.1, 0.2, 0.1),
}

for name, photo in photos.items():
    result, state, score = predict_giraffe(*photo)
    print(f"{name}\n  특징값 {photo} → 계산값 {score} ({state}) → 예측: {result}\n")